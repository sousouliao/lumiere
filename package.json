{
  "name": "lumiere",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @lumiere/desktop build",
    "check": "pnpm check:layout && pnpm release:check && pnpm icons:check && pnpm lint && pnpm format:check && pnpm --filter @lumiere/desktop check",
    "check:layout": "node ./scripts/check-layout.mjs",
    "dev": "pnpm --filter @lumiere/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node ./scripts/generate-icons.mjs",
    "icons:check": "node ./scripts/check-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "package:windows": "node ./scripts/package-windows.mjs",
    "release:windows:finalize": "node ./scripts/finalize-windows-release.mjs",
    "release:check": "node ./scripts/release-metadata.mjs check",
    "release:finalize": "node ./scripts/release-metadata.mjs finalize",
    "release:inspect": "node ./scripts/release-metadata.mjs inspect",
    "release:notes": "node ./scripts/release-metadata.mjs notes",
    "prepare": "simple-git-hooks",
    "start": "pnpm --filter @lumiere/desktop start",
    "test": "pnpm test:shared",
    "test:shared": "pnpm --filter @lumiere/desktop test:shared"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yaml,yml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged --max-arg-length 7000"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
