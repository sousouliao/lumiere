{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiere.local/protocol/platform-host/v6.schema.json",
  "title": "Lumiere platform host protocol v6",
  "oneOf": [
    {
      "$ref": "#/$defs/getCapabilitiesRequest"
    },
    {
      "$ref": "#/$defs/captureDisplayRequest"
    },
    {
      "$ref": "#/$defs/captureRegionRequest"
    },
    {
      "$ref": "#/$defs/cancelRegionRequest"
    },
    {
      "$ref": "#/$defs/successResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "requestEnvelope": {
      "type": "object",
      "required": ["version", "id", "method", "params"],
      "properties": {
        "version": {
          "const": 6
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "method": {},
        "params": {}
      }
    },
    "getCapabilitiesRequest": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "method": {
              "const": "getCapabilities"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "captureDisplayRequest": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "method": {
              "const": "captureDisplay"
            },
            "params": {
              "$ref": "#/$defs/displayCaptureParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "cancelRegionRequest": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "method": {
              "const": "cancelRegion"
            },
            "params": {
              "type": "object",
              "required": ["requestId"],
              "properties": {
                "requestId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "contractVersion",
        "platform",
        "hostStatus",
        "captureModes",
        "deliveryTargets",
        "hdrCapture",
        "outputProfiles"
      ],
      "properties": {
        "contractVersion": {
          "const": 6
        },
        "platform": {
          "const": "windows"
        },
        "hostStatus": {
          "enum": ["available", "unavailable"]
        },
        "captureModes": {
          "type": "array",
          "items": {
            "enum": ["region", "display"]
          },
          "uniqueItems": true
        },
        "deliveryTargets": {
          "type": "array",
          "items": {
            "enum": ["clipboard", "folder"]
          },
          "uniqueItems": true
        },
        "hdrCapture": {
          "enum": ["supported", "unavailable", "unvalidated"]
        },
        "outputProfiles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "srgb-visual-match"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "unavailableReason": {
          "$ref": "#/$defs/failure"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "hostStatus": {
                "const": "unavailable"
              }
            },
            "required": ["hostStatus"]
          },
          "then": {
            "properties": {
              "unavailableReason": {
                "$ref": "#/$defs/failure"
              }
            },
            "required": ["unavailableReason"]
          }
        }
      ]
    },
    "successResponse": {
      "type": "object",
      "required": ["version", "id", "result"],
      "properties": {
        "version": {
          "const": 6
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/capabilities"
            },
            {
              "$ref": "#/$defs/captureResult"
            },
            {
              "$ref": "#/$defs/releasedRegion"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["version", "id", "error"],
      "properties": {
        "version": {
          "const": 6
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "#/$defs/failure"
        }
      },
      "additionalProperties": false
    },
    "captureRegionRequest": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "method": {
              "const": "captureRegion"
            },
            "params": {
              "$ref": "#/$defs/displayCaptureParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "displayCaptureParams": {
      "type": "object",
      "required": ["delivery"],
      "properties": {
        "delivery": {
          "$ref": "#/$defs/outputDelivery"
        },
        "saveDirectory": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/saveDirectoryRule"
        }
      ],
      "additionalProperties": false
    },
    "outputDelivery": {
      "enum": ["clipboard", "folder", "both"]
    },
    "saveDirectoryRule": {
      "if": {
        "type": "object",
        "properties": {
          "delivery": {
            "const": "clipboard"
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "type": "object",
        "properties": {
          "saveDirectory": false
        }
      }
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "host-unavailable",
            "permission-denied",
            "capture-unavailable",
            "delivery-unavailable",
            "delivery-failed",
            "invalid-request",
            "unexpected-failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "captureResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "sourceDynamicRange", "outputProfile", "deliveries"],
          "properties": {
            "status": {
              "const": "completed"
            },
            "sourceDynamicRange": {
              "enum": ["sdr", "hdr"]
            },
            "outputProfile": {
              "const": "srgb-visual-match"
            },
            "deliveries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/deliveryResult"
              },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "const": "cancelled"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "failure"],
          "properties": {
            "status": {
              "const": "failed"
            },
            "failure": {
              "$ref": "#/$defs/failure"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "deliveryResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["target", "status"],
          "properties": {
            "target": {
              "const": "clipboard"
            },
            "status": {
              "const": "success"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "status", "filePath"],
          "properties": {
            "target": {
              "const": "folder"
            },
            "status": {
              "const": "success"
            },
            "filePath": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "status", "failure"],
          "properties": {
            "target": {
              "enum": ["clipboard", "folder"]
            },
            "status": {
              "const": "failed"
            },
            "failure": {
              "$ref": "#/$defs/failure"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "releasedRegion": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "const": "released"
        }
      },
      "additionalProperties": false
    }
  }
}
