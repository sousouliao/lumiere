{
  "name": "@lumiere/desktop",
  "version": "0.8.0",
  "private": true,
  "productName": "Lumiere",
  "description": "Windows Lumiere desktop shell",
  "scripts": {
    "build": "vite build --config vite.tauri.config.ts",
    "build:native": "node ../../scripts/package-windows.mjs prepare-release",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "predev": "cargo build -p lumiere-windows-host",
    "dev": "tauri dev",
    "start": "../../target/release/Lumiere.exe",
    "test": "pnpm test:shared",
    "test:shared": "vitest run --config vitest.shared.config.ts",
    "ui:add": "shadcn add",
    "ui:dry-run": "shadcn add --dry-run",
    "ui:update": "shadcn add --overwrite",
    "ui:view": "shadcn view"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.17.1",
    "clsx": "2.1.1",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
