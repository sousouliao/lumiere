{
  "appId": "io.github.sousouliao.lumiere",
  "productName": "Lumiere",
  "asar": true,
  "npmRebuild": false,
  "electronLanguages": ["en"],
  "directories": {
    "output": "../../artifacts/macos/build"
  },
  "files": ["out/**/*"],
  "extraResources": [
    {
      "from": "resources/icons/mac/trayTemplate.png",
      "to": "icons/mac/trayTemplate.png"
    },
    {
      "from": "resources/icons/mac/trayTemplate@2x.png",
      "to": "icons/mac/trayTemplate@2x.png"
    },
    {
      "from": "../../hosts/macos/.build/distribution/staged/${arch}/LumiereMacHost",
      "to": "macos-host/LumiereMacHost"
    }
  ],
  "mac": {
    "target": "dir",
    "category": "public.app-category.graphics-design",
    "icon": "resources/icons/mac/app.icns",
    "minimumSystemVersion": "15.0",
    "extendInfo": {
      "LSUIElement": true
    },
    "identity": "-",
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "binaries": ["Contents/Resources/macos-host/LumiereMacHost"],
    "gatekeeperAssess": false,
    "notarize": false
  },
  "dmg": {
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
    "title": "Lumiere ${version}",
    "backgroundColor": "#f4f2ee",
    "iconSize": 96,
    "window": {
      "width": 520,
      "height": 320
    },
    "contents": [
      {
        "x": 140,
        "y": 160,
        "type": "file"
      },
      {
        "x": 380,
        "y": 160,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "filesystem": "HFS+",
    "format": "UDZO",
    "sign": false,
    "writeUpdateInfo": false
  }
}
