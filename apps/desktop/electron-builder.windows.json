{
  "appId": "io.github.sousouliao.lumiere",
  "productName": "Lumiere",
  "asar": true,
  "npmRebuild": false,
  "publish": [
    { "provider": "github", "owner": "sousouliao", "repo": "lumiere", "releaseType": "release" }
  ],
  "directories": {
    "output": "../../artifacts/windows/build"
  },
  "files": ["out/**/*"],
  "extraResources": [
    {
      "from": "resources/icons",
      "to": "icons"
    },
    {
      "from": "../../artifacts/windows/staging/windows-host",
      "to": "windows-host"
    },
    {
      "from": "build/windows-installer",
      "to": "windows-installer"
    }
  ],
  "win": {
    "verifyUpdateCodeSignature": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icons/windows/app.ico",
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "Lumiere-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lumiere",
    "deleteAppDataOnUninstall": false,
    "differentialPackage": false,
    "include": "build/installer.windows.nsh"
  }
}
