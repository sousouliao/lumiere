{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumiere",
  "version": "0.6.0",
  "identifier": "io.github.sousouliao.lumiere",
  "build": {
    "beforeDevCommand": "pnpm exec vite --config vite.tauri.config.ts",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out/renderer",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["../resources/icons/windows/app.ico", "../resources/icons/windows/app.png"]
  }
}
